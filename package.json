{
  "name": "quranscope-nextjs",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "npm run sync && npm run validate:keys:cleanup && npm run validate && npm run validate:key-format && next build",
    "build:force": "next build",
    "deploy": "gh-pages -d out",
    "sync": "node scripts/sync-translations.js",
    "start": "next start",
    "lint": "next lint",
    "validate": "node scripts/validate-translations.js",
    "validate:keys": "node scripts/validate-translation-keys.js",
    "validate:keys:cleanup": "node scripts/validate-translation-keys.js --cleanup",
    "validate:key-format": "node scripts/validate-key-format.js",
    "validate:language": "node scripts/validate-language-content.js",
    "validate:usage": "node scripts/validate-translation-usage.js",
    "validate:all": "node scripts/validate-translations.js && node scripts/validate-language-content.js && node scripts/validate-translation-keys.js && node scripts/validate-key-format.js",
    "validate:report": "node scripts/translation-report.js",
    "validate:watch": "nodemon --watch lang --exec \"npm run validate:all\"",
    "translate": "node scripts/translate-deepl.js",
    "translate:usage": "node scripts/translate-deepl.js usage",
    "translate:antisemitism": "node scripts/translate-deepl.js antisemitism_en.json",
    "translate:jihad": "node scripts/translate-deepl.js jihad_en.json",
    "translate:exmuslim": "node scripts/translate-deepl.js exmuslim_en.json",
    "translate:all": "npm run translate:antisemitism && npm run translate:jihad && npm run translate:exmuslim",
    "translate:google": "node scripts/auto-translate.js",
    "translate:google:antisemitism": "node scripts/auto-translate.js antisemitism_en.json",
    "translate:google:jihad": "node scripts/auto-translate.js jihad_en.json",
    "translate:google:exmuslim": "node scripts/auto-translate.js exmuslim_en.json",
    "translate:google:all": "npm run translate:google:antisemitism && npm run translate:google:jihad && npm run translate:google:exmuslim",
    "translate:check": "node scripts/check-translation-status.js",
    "refactor:keys": "node scripts/refactor-translation-keys.js",
    "refactor:keys:dry-run": "node scripts/refactor-translation-keys.js --dry-run",
    "test": "playwright test",
    "test:strict": "playwright test tests/strict-content.spec.js",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "next": "^16.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitalets/google-translate-api": "^9.2.1",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "deepl-node": "^1.24.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "react-snap": "^1.23.0",
    "tailwindcss": "^4.1.18",
    "vite": "^7.2.4"
  }
}
